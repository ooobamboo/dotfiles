#!/usr/bin/bash -x

killall -9 xdg-desktop-portal-wlr xdg-desktop-portal-hyprland xdg-desktop-portal-gnome xdg-desktop-portal-kde xdg-desktop-portal 2>/dev/null

sleep 0.5

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

sleep 1.5

/usr/libexec/xdg-desktop-portal-wlr -r &

sleep 1

/usr/libexec/xdg-desktop-portal -r &

sleep 1.5
